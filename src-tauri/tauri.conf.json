{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remoctrl",
  "version": "0.0.1",
  "identifier": "app.remoctrl.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Remoctrl",
        "width": 380,
        "height": 760,
        "minWidth": 150,
        "minHeight": 200,
        "x": 24,
        "y": 20,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "fullscreen": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost http: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://*:* https://*:* ws://*:* wss://*:*"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "tooltip": "Remoctrl"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Universal smart TV remote",
    "longDescription": "Remoctrl is a fast, honest, beautiful universal remote for smart TVs. Compatible with Roku, Samsung, LG, and more.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["PortugueseBR", "English"]
      }
    }
  }
}
