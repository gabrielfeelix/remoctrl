{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities — habilita IPC core, tray, atalho global e store de TVs/configs",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:webview:default",
    "core:event:default",
    "core:app:default",
    "core:tray:default",
    "shell:default",
    "global-shortcut:default",
    "store:default"
  ]
}
