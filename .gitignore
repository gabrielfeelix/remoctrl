# --- Code signing secrets ---
# NUNCA committar PFX, chave privada do cert (mesmo o self-signed)
codesign/*.pfx
codesign/*.key
codesign/*.p12
# .crt público pode commitar (não tem secret), mas vou deixar fora por ora
codesign/*.crt

# --- Build artifacts não rastreados ---
*.rpm
*.exe.signed

